# docker-compose.yml이 읽는 배포용 환경변수 템플릿.
# 실제 값을 채운 뒤 파일명을 ".env"로 바꿔서 EC2 인스턴스의 프로젝트 루트에 둔다
# (docker-compose.yml과 같은 위치). 이 파일 자체는 절대 git에 커밋하지 않는다
# (.gitignore에 .env가 이미 등록되어 있음).

# MySQL 컨테이너 초기화용 계정 정보. root 비밀번호와 앱 전용 계정 비밀번호는
# 반드시 다른 강력한 값으로 바꿀 것 (아래는 예시일 뿐, 그대로 쓰지 말 것).
MYSQL_DATABASE=tep_db
MYSQL_USER=tep
MYSQL_PASSWORD=바꾸세요_강력한_비밀번호
MYSQL_ROOT_PASSWORD=바꾸세요_강력한_루트비밀번호

# Groq API 키 (조치가이드 생성용 LLM 호출). https://console.groq.com 에서 발급.
GROQ_API_KEY=gsk_여기에_실제_키_입력
