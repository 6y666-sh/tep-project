# 환경/시크릿
.env
venv/
__pycache__/
*.pyc

# 대용량 데이터 (Kaggle에서 직접 받도록, 저장소에는 안 올림)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# 학습된 모델/벡터DB (용량 크면 Git LFS 검토, 우선 제외)
models/*
!models/.gitkeep
vectorstore/*
!vectorstore/.gitkeep

# KOSHA 원문 (저작권/용량 이슈로 제외, 다운로드 스크립트만 커밋)
docs/kosha_guides/*
!docs/kosha_guides/.gitkeep

# 프론트엔드 (설치/빌드 결과물, Docker 빌드 시 다시 생성됨)
frontend/node_modules/
frontend/dist/
# vite가 ESM 설정 파일을 빌드할 때 남기는 임시 파일 (정상적으로는 빌드 후 자동
# 삭제되지만, 특정 환경에서 정리가 안 되고 계속 쌓이는 걸 여러 번 확인함)
frontend/vite.config.js.timestamp-*.mjs

# IDE
.vscode/
.idea/
.DS_Store
